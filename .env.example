# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed.
#
#   cp .env.example .env

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Where error alerts are sent.
# Leave unset and the agent emails the Gmail account it signs in as.
# ALERT_EMAIL=you@example.com

# Optional. Allows browser sign-in in a non-interactive run.
# Normally left unset: it exists so a cron run fails fast instead of
# hanging forever on a browser prompt nobody will ever see.
# ALLOW_BROWSER_AUTH=1
